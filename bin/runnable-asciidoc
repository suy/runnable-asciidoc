#!/usr/bin/env bash
#
# Converts an AsciiDoc document through a runnable-asciidoc backend in lib/
# next to this script: an interactive shell script ("runnable", the default)
# or a JSON document for a graphical viewer ("runnable-json").
#
# Usage: bin/runnable-asciidoc [-b runnable|runnable-json] [-o output] document.adoc
# (all other options pass through to asciidoctor)

set -e

backend=runnable
if [ "$1" = -b ]; then
  backend=$2
  shift 2
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

exec asciidoctor \
  -r "$script_dir/../lib/runnable-asciidoc" \
  -b "$backend" \
  "$@"
